{#
/**
 * @file
 * Unformatted-list output for the Homepage News View.
 *
 * View:
 *   Homepage News
 *
 * Machine name:
 *   homepage_news
 *
 * Display:
 *   block_1
 *
 * The View owns:
 *   - News selection
 *   - published-status filtering
 *   - language filtering
 *   - newest-first sorting
 *   - the number of results returned
 *   - rendering each result with the News Card view mode
 *
 * This template owns only the reusable card-carousel presentation.
 * Each View row is one carousel item. The universal card-carousel
 * component decides how many items are visible at once:
 *   - mobile: 1
 *   - tablet: 2
 *   - desktop: 3
 *
 * Accessibility:
 *   - the carousel does not auto-advance;
 *   - controls are real buttons with accessible names;
 *   - each article exposes its position in the complete result set;
 *   - page indicators are generated by the carousel JavaScript;
 *   - a polite live region announces the visible item range;
 *   - decorative control icons are hidden from assistive technology.
 */
#}

{{ attach_library('ios/card-carousel') }}

{% if title %}
  <h3>{{ title }}</h3>
{% endif %}

{% if rows %}

  {% set news_count = rows|length %}

  <div
    class="ios-carousel ios-carousel--cards w-100"
    id="homepageNewsCarousel"
    data-ios-card-carousel
    data-ios-card-carousel-label="{{ 'news articles'|t }}"
    role="region"
    aria-roledescription="{{ 'carousel'|t }}"
    aria-label="{{ 'Latest news'|t }}"
  >

    <div
      class="ios-card-carousel__viewport"
      data-ios-card-carousel-viewport
    >

      <div
        class="ios-card-carousel__track"
        data-ios-card-carousel-track
      >

        {% for row in rows %}

          {% set row_classes = [
            default_row_class ? 'views-row',
            'ios-card-carousel__item'
          ] %}

          <div
            {{ row.attributes.addClass(row_classes) }}
            data-ios-card-carousel-item
            role="group"
            aria-roledescription="{{ 'slide'|t }}"
            aria-label="{{ 'News article'|t }} {{ loop.index }} {{ 'of'|t }} {{ news_count }}"
          >
            {{ row.content }}
          </div>

        {% endfor %}

      </div>

    </div>

    <div
      class="carousel-indicators"
      data-ios-card-carousel-indicators
      aria-label="{{ 'Choose news page'|t }}"
    ></div>

    <button
      class="carousel-control-prev"
      type="button"
      data-ios-card-carousel-prev
      aria-controls="homepageNewsCarousel"
    >
      <i
        class="fa-solid fa-chevron-left"
        aria-hidden="true"
      ></i>
      <span class="visually-hidden">
        {{ 'Previous news articles'|t }}
      </span>
    </button>

    <button
      class="carousel-control-next"
      type="button"
      data-ios-card-carousel-next
      aria-controls="homepageNewsCarousel"
    >
      <i
        class="fa-solid fa-chevron-right"
        aria-hidden="true"
      ></i>
      <span class="visually-hidden">
        {{ 'Next news articles'|t }}
      </span>
    </button>

    <div
      class="ios-card-carousel__status"
      data-ios-card-carousel-status
      aria-live="polite"
      aria-atomic="true"
    ></div>

  </div>

{% endif %}
