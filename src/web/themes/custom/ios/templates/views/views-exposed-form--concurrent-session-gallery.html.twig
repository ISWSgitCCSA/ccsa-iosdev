
{#
/**
 * @file
 * Exposed filters for the Concurrent Session Gallery.
 *
 * Drupal provides the enclosing form element.
 * Dynamic taxonomy pills are prepared in ios.theme.
 */
#}

<div class="py-3">

  <div class="row g-3 align-items-center">

    <div class="col-12 col-lg">
      {{ form.gallery_pills }}
      {{ form.field_activity_type_target_id }}
    </div>

    <div class="col-12 col-lg-4">
      {{ form.title }}
    </div>

    <div class="col-12 col-lg-auto">
      {{ form.actions }}
    </div>

  </div>

</div>

{{ form|without(
  'gallery_pills',
  'field_activity_type_target_id',
  'title',
  'actions'
) }}
