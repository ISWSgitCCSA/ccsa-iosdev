{#
/**
 * @file
 * Standalone Session Program Card view mode.
 *
 * Content type:
 *   Session
 *
 * View mode:
 *   Program Card
 *
 * Machine names:
 *   Content type: session
 *   View mode: program_card
 *
 * Standalone Sessions appear directly on the Conference Program rail.
 * Sessions assigned to a Concurrent Session are excluded by the View and
 * continue to render inside the existing concurrent-session gallery.
 *
 * Additional variables supplied by ios.theme:
 *   session_start_timestamp
 *   session_end_timestamp
 *   session_start_datetime
 *   session_end_datetime
 *   session_program_speaker
 *   session_program_summary
 *   session_activity_type_label
 *   session_activity_type_class
 */
#}

{# ==========================================================
   SESSION VALUES
   ========================================================== #}

{% set session_title = node.label %}
{% set card_title_id = 'session-program-card-title-' ~ node.id %}

{% set start_timestamp = session_start_timestamp|default(null) %}
{% set end_timestamp = session_end_timestamp|default(null) %}
{% set start_datetime = session_start_datetime|default(null) %}
{% set end_datetime = session_end_datetime|default(null) %}

{% set activity_type_label = session_activity_type_label|default('') %}
{% set activity_type_class = session_activity_type_class|default('ccsa-medium-accent-bg') %}
{% set speaker = session_program_speaker|default(null) %}
{% set summary = session_program_summary|default('') %}
{% set room = node.field_room.value|default('') %}

{# ==========================================================
   PRIMARY SPEAKER VALUES
   ========================================================== #}

{% set speaker_media =
  speaker and speaker.field_featured_image.entity
    ? speaker.field_featured_image.entity
    : null
%}

{% set speaker_image_item =
  speaker_media and speaker_media.field_media_image.0
    ? speaker_media.field_media_image.0
    : null
%}

{% set speaker_image_file =
  speaker_image_item and speaker_image_item.entity
    ? speaker_image_item.entity
    : null
%}

{% set speaker_image_uri =
  speaker_image_file
    ? speaker_image_file.uri.value
    : null
%}

{% set speaker_role =
  speaker and not speaker.field_role.isEmpty
    ? speaker.field_role.value
    : ''
%}

{% set speaker_organization =
  speaker and not speaker.field_organization_role.isEmpty
    ? speaker.field_organization_role.value
    : ''
%}


{# ==========================================================
   PROGRAM SCHEDULE SLOT
   ========================================================== #}

<div class="ios-conference-program__slot">

  {# ========================================================
     TIME RAIL
     ======================================================== #}

  <div class="ios-conference-program__time">

    {% if start_timestamp %}
      <div class="ios-conference-program__time-range">
        <time
          class="fw-bold"
          {% if start_datetime %}datetime="{{ start_datetime }}"{% endif %}
        >
          {{ start_timestamp|format_date('custom', 'g:i A') }}
        </time>

        {% if end_timestamp %}
          <span class="small text-body-secondary">
            {{ 'to'|t }}
            <time
              {% if end_datetime %}datetime="{{ end_datetime }}"{% endif %}
            >
              {{ end_timestamp|format_date('custom', 'g:i A') }}
            </time>
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if activity_type_label %}
      <div class="ios-conference-program__time-label small fw-bold text-uppercase warm">
        {{ activity_type_label }}
      </div>
    {% endif %}

  </div>


  {# ========================================================
     STANDALONE SESSION CARD
     ======================================================== #}

  <div class="ios-conference-program__slot-content">

    <article
      {{ attributes.addClass(
        'card',
        'ios-card',
        'ios-program-card--keynote'
      ) }}
      aria-labelledby="{{ card_title_id }}"
    >
      <div class="card-body p-4">

        {% if activity_type_label %}
          <div class="ios-tag mb-3">
            <span class="badge rounded-pill {{ activity_type_class }}">
              {{ activity_type_label }}
            </span>
          </div>
        {% endif %}

        <div class="row g-4">

          {# ==================================================
             PRIMARY SPEAKER / SESSION INFORMATION
             ================================================== #}

          <div class="col-12 col-md-4">

            {% if room %}
              <p class="small text-body-secondary mb-3">
                <i
                  class="fa-solid fa-location-dot me-1"
                  aria-hidden="true"
                ></i>
                {{ room }}
              </p>
            {% endif %}

            {% if speaker %}
              <div class="ios-program-card__speaker mb-3">

                {% if speaker_image_uri %}
                  <img
                    class="ios-program-card__speaker-image"
                    src="{{ file_url(speaker_image_uri) }}"
                    alt=""
                  />
                {% endif %}

                <div class="ios-program-card__speaker-copy">
                  <p class="fw-bold cool-dark mb-1">
                    <a href="{{ path('entity.node.canonical', {'node': speaker.id}) }}">
                      {{ speaker.label }}
                    </a>
                  </p>

                  {% if speaker_role or speaker_organization %}
                    <p class="small text-body-secondary mb-0">
                      {% if speaker_role %}
                        {{ speaker_role }}
                      {% endif %}

                      {% if speaker_role and speaker_organization %}
                        <br />
                      {% endif %}

                      {% if speaker_organization %}
                        {{ speaker_organization }}
                      {% endif %}
                    </p>
                  {% endif %}
                </div>

              </div>
            {% endif %}

            <a
              class="btn btn-ios btn-ios-view-more btn-arrow ccsa-medium-accent-bg"
              href="{{ url }}"
            >
              {{ 'More details'|t }}
              <span class="visually-hidden">: {{ session_title }}</span>
            </a>

          </div>


          {# ==================================================
             SESSION DESCRIPTION
             ================================================== #}

          <div class="col-12 col-md-8">

            {{ title_prefix }}

            <h3
              id="{{ card_title_id }}"
              class="card-title h5 cool-dark mb-3"
            >
              {{ label }}
            </h3>

            {{ title_suffix }}

            {% if summary %}
              <p class="card-text mb-0">
                {{ summary }}
              </p>
            {% endif %}

          </div>

        </div>
      </div>
    </article>

  </div>

</div>
