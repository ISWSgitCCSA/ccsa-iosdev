{#
/**
 * @file
 * Full Program Page node template.
 *
 * Content type:
 *   Program Page
 *
 * Machine name:
 *   program_page
 *
 * Fields:
 *   field_banner_image
 *   field_hero_copy
 *   body
 *
 * Additional variables supplied by ios.theme:
 *   conference_program
 *     Render array for the Conference Program View block.
 *
 * The banner image is decorative because the page title and
 * supporting information are provided as HTML text.
 */
#}


{# ==========================================================
   FIELD VALUES
   ========================================================== #}

{% set hero_copy =
  node.field_hero_copy.value|default('')
%}


{# ==========================================================
   BANNER IMAGE
   ========================================================== #}

{% set banner_media =
  node.field_banner_image.entity
%}

{% set banner_image_item =
  banner_media
    ? banner_media.field_media_image.0
    : null
%}

{% set banner_image_file =
  banner_image_item
  and banner_image_item.entity
    ? banner_image_item.entity
    : null
%}

{% set banner_image_uri =
  banner_image_file
    ? banner_image_file.uri.value
    : null
%}


{# ==========================================================
   PROGRAM PAGE
   ========================================================== #}

<article{{ attributes.addClass('ios-program-page') }}>


  {# ========================================================
     PAGE HEADER
     ======================================================== #}

  <header
    class="
      ios-page-header
      ios-page-header--medium
      ios-program-page__header
    "
    aria-labelledby="program-page-title"
  >

    {% if banner_image_uri %}

      <img
        class="ios-page-header__image"
        src="{{ file_url(banner_image_uri) }}"
        alt=""
        aria-hidden="true"
      />

    {% endif %}


    <div
      class="ios-page-header__overlay"
      aria-hidden="true"
    ></div>


    <div class="ios-page-header__content">

      <div class="ios-page-header__copy">

        {{ title_prefix }}

        <h1
          id="program-page-title"
          class="
            ios-page-header__title
            ios-page-header-text-outline
          "
        >
          {{ label }}
        </h1>

        {{ title_suffix }}


        {% if hero_copy %}

          <div
            class="
              ios-page-header__intro
              ios-page-header-text-outline
            "
          >
            {{ hero_copy|raw }}
          </div>

        {% endif %}

      </div>

    </div>

  </header>


  {# ========================================================
     EDITORIAL INTRODUCTION
     ======================================================== #}

  {% if content.body %}

    <section
      class="ios-program-page__intro py-5"
      aria-label="{{ 'Program introduction'|t }}"
    >

      <div class="container-fluid px-4 px-xl-5">

        <div class="row">

          <div class="col-12 col-xl-10">

            {{ content.body }}

          </div>

        </div>

      </div>

    </section>

  {% endif %}


  {# ========================================================
     CONFERENCE PROGRAM
     ======================================================== #}

  {% if conference_program %}

    <section
      class="ios-program-page__schedule pb-5"
      aria-label="{{ 'Conference program'|t }}"
    >

      <div class="container-fluid px-4 px-xl-5">

        {{ conference_program }}

      </div>

    </section>

  {% endif %}

</article>