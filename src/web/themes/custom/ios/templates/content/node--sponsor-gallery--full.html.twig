{#
/**
 * @file
 * Full Sponsor Gallery page template.
 *
 * Content type: Sponsor Gallery (sponsor_gallery)
 * Fields: field_banner_image, field_hero_copy, body
 *
 * Views render arrays are supplied by the site's existing preprocessing:
 *   sponsor_gallery_national   -> sponsor_gallery / block_1
 *   sponsor_gallery_provincial -> sponsor_gallery / block_2
 *   sponsor_gallery_silver     -> sponsor_gallery / block_3
 *   sponsor_gallery_other      -> sponsor_gallery / block_4
 *
 * Individual cards are rendered by:
 *   views-view-fields--sponsor-gallery.html.twig
 *
 * Display-specific Views row/group templates control the grids.
 * All styling here uses Bootstrap and the existing IOS theme utilities.
 */
#}

{# ==========================================================
   FIELD VALUES
   ========================================================== #}

{% set hero_copy = node.field_hero_copy.value|default('') %}

{% set banner_media = node.field_banner_image.entity %}

{% set banner_image_item =
  banner_media
    ? banner_media.field_media_image.0
    : null
%}

{% set banner_image_file =
  banner_image_item and banner_image_item.entity
    ? banner_image_item.entity
    : null
%}

{% set banner_image_uri =
  banner_image_file
    ? banner_image_file.uri.value
    : null
%}

{# ==========================================================
   SPONSOR GALLERY
   ========================================================== #}

<article{{ attributes.addClass('ios-sponsor-gallery') }}>

  {# --------------------------------------------------------
     PAGE HEADER
     -------------------------------------------------------- #}

  <header
    class="ios-page-header ios-page-header--medium ios-sponsor-gallery__header"
    aria-labelledby="sponsor-gallery-title"
  >
    {% if banner_image_uri %}
      <img
        class="ios-page-header__image"
        src="{{ file_url(banner_image_uri) }}"
        alt=""
        aria-hidden="true"
      />
    {% endif %}

    <div class="ios-page-header__overlay" aria-hidden="true"></div>

    <div class="ios-page-header__content">
      <div class="ios-page-header__copy">
        {{ title_prefix }}

        <h1
          id="sponsor-gallery-title"
          class="ios-page-header__title ios-page-header-text-outline"
        >
          {{ label }}
        </h1>

        {{ title_suffix }}

        {% if hero_copy %}
          <div class="ios-page-header__intro ios-page-header-text-outline">
            {{ hero_copy|raw }}
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {# --------------------------------------------------------
     EDITORIAL INTRODUCTION
     -------------------------------------------------------- #}

  {% if content.body %}
    <section
      class="ios-sponsor-gallery__intro py-5"
      aria-label="{{ 'Sponsor gallery introduction'|t }}"
    >
      <div class="container-fluid px-4 px-xl-5">
        <div class="row">
          <div class="col-12 col-xl-10">
            {{ content.body }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}

  {# --------------------------------------------------------
     NATIONAL SPONSOR
     One prominent horizontal card, with generous spacing.
     -------------------------------------------------------- #}

  {% if sponsor_gallery_national %}
    <section
      class="ios-sponsor-gallery__national pb-5"
      aria-labelledby="sponsor-gallery-national-title"
    >
      <div class="container-fluid px-4 px-xl-5">
        <div class="cool-light-bg rounded-4 p-4 p-lg-5">
          <h2
            id="sponsor-gallery-national-title"
            class="h3 fw-bold cool-dark border-bottom pb-3 mb-4"
          >
            {{ 'National Sponsor'|t }}
          </h2>

          {{ sponsor_gallery_national }}
        </div>
      </div>
    </section>
  {% endif %}

  {# --------------------------------------------------------
     PROVINCIAL SPONSORS
     Centred vertical card(s), enclosed in a lighter panel.
     The block_2 unformatted Views template creates its grid.
     -------------------------------------------------------- #}

  {% if sponsor_gallery_provincial %}
    <section
      class="ios-sponsor-gallery__provincial pb-5"
      aria-labelledby="sponsor-gallery-provincial-title"
    >
      <div class="container-fluid px-4 px-xl-5">
        <div class="cool-light-bg rounded-4 p-4 p-lg-5">
          <h2
            id="sponsor-gallery-provincial-title"
            class="h3 fw-bold cool-dark border-bottom pb-3 mb-4"
          >
            {{ 'Provincial Sponsors'|t }}
          </h2>

          {{ sponsor_gallery_provincial }}
        </div>
      </div>
    </section>
  {% endif %}

  {# --------------------------------------------------------
     SILVER SPONSORS
     Two cards per row from medium screens upwards.
     The block_3 unformatted Views template creates its grid.
     -------------------------------------------------------- #}

  {% if sponsor_gallery_silver %}
    <section
      class="ios-sponsor-gallery__silver pb-5"
      aria-labelledby="sponsor-gallery-silver-title"
    >
      <div class="container-fluid px-4 px-xl-5">
        <div class="cool-light-bg rounded-4 p-4 p-lg-5">
          <h2
            id="sponsor-gallery-silver-title"
            class="h3 fw-bold cool-dark border-bottom pb-3 mb-4"
          >
            {{ 'Silver Sponsors'|t }}
          </h2>

          {{ sponsor_gallery_silver }}
        </div>
      </div>
    </section>
  {% endif %}

  {# --------------------------------------------------------
     ADDITIONAL SPONSORS
     The block_4 View groups rows by Sponsor Level taxonomy.
     The block_4 Views templates generate two-column group panels.
     -------------------------------------------------------- #}

  {% if sponsor_gallery_other %}
    <section
      class="ios-sponsor-gallery__other pb-5"
      aria-labelledby="sponsor-gallery-other-title"
    >
      <div class="container-fluid px-4 px-xl-5">
        <h2 id="sponsor-gallery-other-title" class="visually-hidden">
          {{ 'Additional sponsors and supporters'|t }}
        </h2>

        {{ sponsor_gallery_other }}
      </div>
    </section>
  {% endif %}

</article>
