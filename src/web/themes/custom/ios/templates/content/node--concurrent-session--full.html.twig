{#
/**
 * @file
 * Full Concurrent Session node template.
 *
 * Content type:
 *   Concurrent Session
 *
 * Machine name:
 *   concurrent_session
 *
 * Fields:
 *   field_activity_type
 *   field_banner_image
 *   body
 *   field_concurrent_track
 *   field_end_date_time
 *   field_meta_tags
 *   field_related_sessions
 *   field_room
 *   field_secondary_body
 *   field_session_location_embed
 *   field_session_location_image
 *   field_session_number
 *   field_start_date_time
 *
 * Media image field:
 *   field_media_image
 *
 * Additional variables:
 *   session_speakers
 *     Supplied by the IOS theme from the Session Speakers View.
 *
 *   related_session_cards
 *     Supplied by the IOS theme.
 *     Manual Related Sessions take priority.
 *     Automatic fallback uses shared Concurrent Track and Speakers.
 *
 *   session_start_timestamp
 *   session_end_timestamp
 *     Absolute timestamps generated by ios.theme from Drupal's UTC
 *     datetime storage values.
 *
 *   session_start_datetime
 *   session_end_datetime
 *     Machine-readable UTC values for HTML <time> attributes.
 *
 *   session_location_embed_src
 *     Resolved embed URL supplied by the IOS Session Location module.
 *
 *   session_location_embed_initial_height
 *     Initial iframe height supplied by the IOS Session Location module.
 *
 * Breadcrumbs are handled separately by Drupal and are intentionally
 * not rendered or styled by this template.
 */
#}


{# ==========================================================
   FIELD VALUES
   ========================================================== #}

{% set session_title = node.label %}


{# Banner image. #}

{% set banner_media =
  node.field_banner_image.entity
%}

{% set banner_image_file =
  banner_media
  and banner_media.field_media_image.entity
    ? banner_media.field_media_image.entity
    : null
%}

{% set banner_image_uri =
  banner_image_file
    ? banner_image_file.uri.value
    : null
%}


{# Date / time / room. #}

{% set start_timestamp =
  session_start_timestamp|default(null)
%}

{% set end_timestamp =
  session_end_timestamp|default(null)
%}

{% set start_datetime =
  session_start_datetime|default(null)
%}

{% set end_datetime =
  session_end_datetime|default(null)
%}

{% set room_value =
  node.field_room.value|default(null)
%}


{# ==========================================================
   SESSION LOCATION EMBED
   ========================================================== #}

{% set location_embed_src =
  session_location_embed_src|default(null)
%}

{% set location_embed_initial_height =
  session_location_embed_initial_height|default(400)
%}


{# ==========================================================
   SESSION LOCATION IMAGE
   ========================================================== #}

{% set location_media =
  node.field_session_location_image.entity
%}

{% set location_image_item =
  location_media
  and location_media.field_media_image.0
    ? location_media.field_media_image.0
    : null
%}

{% set location_image_file =
  location_image_item
  and location_image_item.entity
    ? location_image_item.entity
    : null
%}

{% set location_image_uri =
  location_image_file
    ? location_image_file.uri.value
    : null
%}

{% set location_image_alt =
  location_image_item
  and location_image_item.alt
    ? location_image_item.alt
    : 'Session location for @title'|t({
        '@title': session_title
      })
%}


{# ==========================================================
   LOCATION DISPLAY STATE
   ========================================================== #}

{% set has_location_media =
  location_embed_src
  or location_image_uri
%}


{# ==========================================================
   CONCURRENT SESSION
   ========================================================== #}

<article{{ attributes.addClass('ios-session-page') }}>


  {# ========================================================
     SESSION HEADER
     ======================================================== #}

  <header
    class="ios-page-header ios-page-header--narrow"
    aria-labelledby="session-page-title"
  >

    {% if banner_image_uri %}

      <img
        class="ios-page-header__image"
        src="{{ file_url(banner_image_uri) }}"
        alt=""
        aria-hidden="true"
      />

    {% endif %}


    <div
      class="ios-page-header__overlay"
      aria-hidden="true"
    ></div>


    <div class="ios-page-header__content">

      <div class="ios-page-header__copy">

        {{ title_prefix }}

        <h1
          id="session-page-title"
          class="ios-page-header__title ios-page-header-text-outline"
        >
          {{ label }}
        </h1>

        {{ title_suffix }}


        {# ==================================================
           SESSION DATE / TIME / ROOM
           ================================================== #}

        {% if start_timestamp is not null
          or end_timestamp is not null
          or room_value
        %}

          <div
            class="ios-page-header__meta"
            aria-label="{{ 'Session details'|t }}"
          >


            {# Date. #}

            {% if start_timestamp is not null %}

              <div class="ios-page-header__meta-item">

                <i
                  class="fa-regular fa-calendar-days"
                  aria-hidden="true"
                ></i>

                <time datetime="{{ start_datetime }}">
                  {{ start_timestamp|format_date('ios_session_date') }}
                </time>

              </div>

            {% endif %}


            {# Time range. #}

            {% if start_timestamp is not null %}

              <div class="ios-page-header__meta-item">

                <i
                  class="fa-regular fa-clock"
                  aria-hidden="true"
                ></i>

                <span>

                  <time datetime="{{ start_datetime }}">
                    {{ start_timestamp|format_date('ios_session_time') }}
                  </time>

                  {% if end_timestamp is not null %}

                    <span aria-hidden="true">
                      –
                    </span>

                    <span class="visually-hidden">
                      {{ 'to'|t }}
                    </span>

                    <time datetime="{{ end_datetime }}">
                      {{ end_timestamp|format_date('ios_session_time') }}
                    </time>

                  {% endif %}

                </span>

              </div>

            {% endif %}


            {# Room / textual location. #}

            {% if room_value %}

              <div class="ios-page-header__meta-item">

                <i
                  class="fa-solid fa-location-dot"
                  aria-hidden="true"
                ></i>

                <span>
                  {{ 'Room '|t }}{{ room_value }}
                </span>

              </div>

            {% endif %}


          </div>

        {% endif %}

      </div>

    </div>

  </header>


  {# ========================================================
     ABOUT THIS SESSION
     ======================================================== #}

  {% if not node.body.isEmpty %}

    <section
      class="py-5"
      aria-labelledby="session-about-heading"
    >

      <div class="container-fluid px-4 px-xl-5">

        <div class="row">

          <div class="col-12 col-xl-9">

            <h2
              id="session-about-heading"
              class="h3 warm-dark mb-2"
            >
              {{ 'About this Session'|t }}
            </h2>

            <div
              class="warm-dark-bg rounded-pill mb-3"
              style="width: 3rem; height: 0.2rem;"
              aria-hidden="true"
            ></div>


            <div class="paragraph-text">
              {{ content.body }}
            </div>

          </div>

        </div>

      </div>

    </section>

  {% endif %}


  {# ========================================================
     SPEAKERS + SESSION LOCATION
     ======================================================== #}

  {% if session_speakers or has_location_media %}

    <section class="pb-5">

      <div class="container-fluid px-4 px-xl-5">

        <div class="row g-5 align-items-start">


          {# ==================================================
             RELATED SPEAKERS
             ================================================== #}

          {% if session_speakers %}

            <div
              class="{{
                has_location_media
                  ? 'col-12 col-lg-6'
                  : 'col-12'
              }}"
            >

              <h2
                id="session-speakers-heading"
                class="h3 warm-dark mb-2"
              >
                {{ 'Speakers'|t }}
              </h2>

              <div
                class="warm-dark-bg rounded-pill mb-4"
                style="width: 3rem; height: 0.2rem;"
                aria-hidden="true"
              ></div>


              {#
                Keep the related-speaker cards from stretching across
                very wide layouts.

                The View itself determines which speakers belong to
                this session. This wrapper only controls its available
                presentation width.
              #}

              <div
                style="max-inline-size: 24rem;"
                aria-labelledby="session-speakers-heading"
              >
                {{ session_speakers }}
              </div>

            </div>

          {% endif %}


          {# ==================================================
             MAP / SESSION LOCATION
             ================================================== #}

          {% if has_location_media %}

            <div
              class="{{
                session_speakers
                  ? 'col-12 col-lg-6'
                  : 'col-12 col-xl-9'
              }}"
            >

              <h2
                id="session-location-heading"
                class="h3 warm-dark mb-2"
              >
                {{ 'Map'|t }}
              </h2>

              <div
                class="warm-dark-bg rounded-pill mb-4"
                style="width: 3rem; height: 0.2rem;"
                aria-hidden="true"
              ></div>


              <div
                aria-labelledby="session-location-heading"
              >


                {# ============================================
                   INTERACTIVE EMBED
                   ============================================ #}

                {% if location_embed_src %}

                  {{ attach_library(
                    'ios_session_location/infogram'
                  ) }}

                  <div
                    class="
                      ios-session-location__frame
                      rounded
                      overflow-hidden
                      border
                    "
                  >

                    <iframe
                      class="
                        ios-session-location__embed
                        d-block
                        w-100
                        border-0
                      "
                      src="{{ location_embed_src }}"
                      title="{{
                        'Session location for @title'|t({
                          '@title': session_title
                        })
                      }}"
                      height="{{ location_embed_initial_height }}"
                      loading="lazy"
                      allowfullscreen
                      allow="fullscreen"
                      data-ios-infogram
                    ></iframe>

                  </div>


                {# ============================================
                   STATIC LOCATION IMAGE
                   ============================================ #}

                {% elseif location_image_uri %}

                  <figure class="m-0">

                    <img
                      class="
                        img-fluid
                        w-100
                        rounded
                        border
                      "
                      src="{{ file_url(location_image_uri) }}"
                      alt="{{ location_image_alt }}"
                    />

                  </figure>

                {% endif %}

              </div>

            </div>

          {% endif %}

        </div>

      </div>

    </section>

  {% endif %}


  {# ========================================================
     RELATED SESSIONS
     ========================================================

     Manual Related Sessions take priority.

     If no sessions were manually selected, ios.theme supplies
     automatic results based on shared Concurrent Track and
     shared Speakers.

     If no related sessions are found, this entire section is
     omitted.
     ======================================================== #}

  {% if related_session_cards %}

    <section
      class="pb-5"
      aria-labelledby="related-sessions-heading"
    >

      <div class="container-fluid px-4 px-xl-5">

        <h2
          id="related-sessions-heading"
          class="h3 warm-dark mb-2"
        >
          {{ 'Related Sessions'|t }}
        </h2>

        <div
          class="warm-dark-bg rounded-pill mb-4"
          style="width: 3rem; height: 0.2rem;"
          aria-hidden="true"
        ></div>


        <div class="row g-4 align-items-stretch">

          {% for related_session_card in related_session_cards %}

            <div class="col-12 col-md-6 col-xl-4">
              {{ related_session_card }}
            </div>

          {% endfor %}

        </div>

      </div>

    </section>

  {% endif %}


  {# ========================================================
     CURRENTLY UNUSED FIELDS
     ========================================================

       field_activity_type
       field_concurrent_track
       field_session_number
       field_secondary_body

     These remain available in Drupal but are intentionally not
     rendered directly by this template.
     ======================================================== #}


  {# Meta Tags have no visible page presentation. #}

  {{ content.field_meta_tags }}

</article>