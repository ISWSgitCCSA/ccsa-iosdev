{#
/**
 * @file
 * Theme override to display a single page.
 *
 * The doctype, html, head and body tags are not in this template.
 * They are found in html.html.twig.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation.
 * - is_front: TRUE when the current page is the front page.
 * - logged_in: TRUE when the user is signed in.
 * - is_admin: TRUE when the user has administration permission.
 *
 * Site identity:
 * - front_page: URL of the front page.
 *
 * Regions:
 * - page.header: Utility header region.
 * - page.nav_branding: Navigation branding region.
 * - page.nav_main: Main navigation region.
 * - page.nav_additional: Additional navigation region.
 * - page.highlighted: Highlighted content.
 * - page.help: Help content.
 * - page.content: Main page content.
 * - page.sidebar_first: First sidebar.
 * - page.sidebar_second: Second sidebar.
 * - page.footer: Footer region.
 * - page.breadcrumb: Breadcrumb region.
 *
 * @see template_preprocess_page()
 * @see html.html.twig
 */
#}


{# =========================================================
   PRIMARY NAVIGATION CLASSES

   IOS colour and dark-mode styles control presentation.
   Avoid Bootstrap navbar-light / navbar-dark and fixed
   background/text colour utilities here.
   ========================================================= #}

{% set nav_classes = 'navbar navbar-expand-lg' %}


{# =========================================================
   SITE HEADER
   ========================================================= #}

<header
  role="banner"
  class="ios-site-header"
>

  {# -------------------------------------------------------
     UTILITY HEADER

     Uses the same wide content boundary as the primary
     navigation and footer.

     Currently contains:
     - Search form
     - User account menu
     ------------------------------------------------------- #}

  {% if page.header %}
    <div class="ios-utility-header">

      <div class="container-fluid px-4 px-xl-5">

        <div class="col-12 col-xxl-11 mx-auto">
          {{ page.header }}
        </div>

      </div>

    </div>
  {% endif %}


  {# -------------------------------------------------------
     BRANDING + PRIMARY NAVIGATION

     Uses the same wide content boundary as the utility
     header and footer.
     ------------------------------------------------------- #}

  {% if page.nav_branding or page.nav_main or page.nav_additional %}

    <nav
      class="{{ nav_classes }} ios-responsive-menu"
      aria-label="Primary navigation"
    >

      <div class="container-fluid px-4 px-xl-5">

        <div
          class="
            col-12
            col-xxl-11
            mx-auto
            d-flex
            flex-wrap
            align-items-center
          "
        >

          {# -------------------------------------------------
             CONFERENCE BRANDING

             Mobile:
             - occupies 9 of 12 Bootstrap columns
             - leaves room for the menu toggle

             Desktop:
             - occupies 5 of 12 columns
             - gives the wide conference logo enough width
               to achieve the intended visual height
             ------------------------------------------------- #}

          {% if page.nav_branding %}
            <div
              class="
                ios-navigation-branding
                col-9
                col-lg-5
                flex-shrink-0
              "
            >
              {{ page.nav_branding }}
            </div>
          {% endif %}


          {# -------------------------------------------------
             MOBILE TOGGLE + MAIN NAVIGATION

             On desktop, the navigation area aligns itself to
             the bottom of the branding area so the menu sits
             along the lower edge of the conference logo.
             ------------------------------------------------- #}

          {% if page.nav_main or page.nav_additional %}

            <button
              class="navbar-toggler ios-menu-toggle collapsed"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent"
              aria-expanded="false"
              aria-label="Toggle navigation"
            >
              <i
                class="fa-solid fa-bars"
                aria-hidden="true"
              ></i>

              <i
                class="fa-solid fa-xmark"
                aria-hidden="true"
              ></i>
            </button>


            <div
              class="
                collapse
                navbar-collapse
                justify-content-lg-end
                align-self-lg-end
              "
              id="navbarSupportedContent"
            >

              {% if page.nav_main %}
                {{ page.nav_main }}
              {% endif %}

              {% if page.nav_additional %}
                {{ page.nav_additional }}
              {% endif %}

            </div>

          {% endif %}

        </div>

      </div>

    </nav>

  {% endif %}

</header>


{# =========================================================
   MAIN CONTENT
   ========================================================= #}

<main role="main">

  <a
    id="main-content"
    tabindex="-1"
  ></a>


  {# -------------------------------------------------------
     SIDEBAR / CONTENT GRID CLASSES
     ------------------------------------------------------- #}

  {%
    set sidebar_first_classes =
      (page.sidebar_first and page.sidebar_second)
        ? 'col-12 col-sm-6 col-lg-3'
        : 'col-12 col-lg-3'
  %}

  {%
    set sidebar_second_classes =
      (page.sidebar_first and page.sidebar_second)
        ? 'col-12 col-sm-6 col-lg-3'
        : 'col-12 col-lg-3'
  %}

  {%
    set content_classes =
      (page.sidebar_first and page.sidebar_second)
        ? 'col-12 col-lg-6'
        : (
          (page.sidebar_first or page.sidebar_second)
            ? 'col-12 col-lg-9'
            : 'col-12'
        )
  %}


  <div class="{{ b5_top_container }}">

    {% if page.breadcrumb %}
      {{ page.breadcrumb }}
    {% endif %}


    <div class="row g-0">

      {% if page.sidebar_first %}
        <div
          class="
            order-2
            order-lg-1
            {{ sidebar_first_classes }}
          "
        >
          {{ page.sidebar_first }}
        </div>
      {% endif %}


      <div
        class="
          order-1
          order-lg-2
          {{ content_classes }}
        "
      >
        {{ page.content }}
      </div>


      {% if page.sidebar_second %}
        <div
          class="
            order-3
            {{ sidebar_second_classes }}
          "
        >
          {{ page.sidebar_second }}
        </div>
      {% endif %}

    </div>

  </div>

</main>


{# =========================================================
   FOOTER

   The Footer region supplies its own internal wide wrapper
   through region--footer.html.twig.
   ========================================================= #}

{% if page.footer %}

  <footer
    id="contact"
    role="contentinfo"
    class="mt-auto ccsa-dark-accent-bg ios-footer"
  >
    {{ page.footer }}
  </footer>

{% endif %}