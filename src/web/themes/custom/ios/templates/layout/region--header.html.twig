{#
/**
 * @file
 * Theme override for the Header region.
 *
 * This region forms the IOS utility navigation bar.
 *
 * Drupal Block Layout controls the order of the blocks.
 *
 * Intended order:
 * 1. User account menu
 * 2. Search form
 *
 * The entire region is displayed as one horizontal row
 * aligned to the right edge of the containing layout.
 */
#}

{% if content %}

  <div{{
    attributes.addClass(
      'ios-utility-menu',
      'd-flex',
      'flex-row',
      'flex-nowrap',
      'justify-content-end',
      'align-items-center',
      'gap-3',
      'w-100',
      'pb-2'
    )
  }}>
    {{ content }}
  </div>

{% endif %}