{#
/**
 * @file
 * Theme override for the IOS Footer region.
 *
 * The semantic <footer> element is provided by page.html.twig.
 *
 * This template controls the internal footer layout only.
 *
 * Footer content remains managed through Drupal's single Footer region.
 * ios.theme exposes the known footer blocks individually so this template
 * can reproduce the established Bootstrap footer layout.
 *
 * Available custom variables:
 * - footer_logo
 * - footer_left
 * - footer_navigation
 * - footer_questions
 * - footer_utility
 *
 * Any additional blocks placed in the Footer region remain available through
 * the normal `content` variable.
 */
#}

{% if
  footer_logo
  or footer_left
  or footer_navigation
  or footer_questions
  or footer_utility
  or content
%}

  <div class="container-fluid px-4 px-xl-5 pt-5">

    {# =====================================================
       WIDE FOOTER CONTENT WRAPPER
       ===================================================== #}

    <div class="row g-0 justify-content-center">
      <div class="col-12 col-xxl-11">

        {# =================================================
           FOOTER BRANDING
           ================================================= #}

        {% if footer_logo %}
          {{ footer_logo }}

          <hr class="my-4 opacity-50">
        {% endif %}


        {# =================================================
           MAIN FOOTER CONTENT
           ================================================= #}

        <div class="row g-5 pb-5">

          {# -----------------------------------------------
             Venue, map and social links
             ----------------------------------------------- #}

          {% if footer_left %}
            <div class="col-12 col-md-6 col-lg-4">
              {{ footer_left }}
            </div>
          {% endif %}


          {# -----------------------------------------------
             Main footer navigation
             ----------------------------------------------- #}

          {% if footer_navigation %}
            <div class="col-12 col-lg-5">
              {{ footer_navigation }}
            </div>
          {% endif %}


          {# -----------------------------------------------
             Questions / contact card
             ----------------------------------------------- #}

          {% if footer_questions %}
            <div class="col-12 col-lg-3">
              {{ footer_questions }}
            </div>
          {% endif %}

        </div>


        {# =================================================
           ANY ADDITIONAL FOOTER BLOCKS
           ================================================= #}

        {% if content %}
          {{ content }}
        {% endif %}


        {# =================================================
           FOOTER UTILITY AREA
           ================================================= #}

        {% if footer_utility %}

          <hr class="my-2 opacity-50">

          <div
            class="
              d-flex
              flex-column
              flex-md-row
              justify-content-end
              gap-3
              py-4
              ios-footer-utility-menu
            "
          >
            {{ footer_utility }}
          </div>

        {% endif %}

      </div>
    </div>

  </div>

{% endif %}