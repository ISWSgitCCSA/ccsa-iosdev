{#
/**
 * @file
 * Theme override for Drupal language-switcher links.
 *
 * Drupal owns:
 * - language URLs
 * - active-language state
 *
 * This template owns:
 * - the short EN / FR labels
 * - the IOS preference-control structure
 *
 * Active presentation is handled after render from Drupal's
 * .is-active / aria-current state.
 */
#}

{% if links -%}

  {%- if heading -%}
    {%- if heading.level -%}
      <{{ heading.level }}{{ heading.attributes.addClass('visually-hidden') }}>
        {{ heading.text }}
      </{{ heading.level }}>
    {%- else -%}
      <h2{{ heading.attributes.addClass('visually-hidden') }}>
        {{ heading.text }}
      </h2>
    {%- endif -%}
  {%- endif -%}

  <ul{{ attributes.addClass('ios-preferences__list') }}>

    {%- for key, item in links -%}

      <li{{ item.attributes.addClass('ios-preferences__item') }}>

        {%- if item.link -%}

          {% set link_options = item.link['#options']|default({}) %}
          {% set link_attributes = link_options.attributes|default({}) %}
          {% set existing_classes = link_attributes.class|default([]) %}

          {% set link_attributes = link_attributes|merge({
            'class': existing_classes|merge([
              'ios-preferences__option',
              'ios-preferences__option--language'
            ]),
            'aria-label': item.text
          }) %}

          {% set link_options = link_options|merge({
            'attributes': link_attributes
          }) %}

          {% set language_link = item.link|merge({
            '#title': key|upper,
            '#options': link_options
          }) %}

          {{ language_link }}

        {%- else -%}

          <span
            class="ios-preferences__option ios-preferences__option--language"
            aria-current="page"
          >
            {{ key|upper }}
          </span>

        {%- endif -%}

      </li>
    {%- endfor -%}

  </ul>
{%- endif %}
