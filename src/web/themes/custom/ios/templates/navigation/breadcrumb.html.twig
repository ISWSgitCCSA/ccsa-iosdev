{#
/**
 * @file
 * IOS theme implementation for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}

{% if breadcrumb %}
  <nav
    class="ios-breadcrumbs"
    aria-labelledby="system-breadcrumb"
  >
    <h2
      id="system-breadcrumb"
      class="visually-hidden"
    >
      {{ 'Breadcrumb'|t }}
    </h2>

    <ol class="breadcrumb">
      {% for item in breadcrumb %}
        <li
          class="breadcrumb-item{% if not item.url %} active{% endif %}"
          {% if not item.url %}
            aria-current="page"
          {% endif %}
        >
          {% if item.url %}
            <a href="{{ item.url }}">
              {{ item.text }}
            </a>
          {% else %}
            {{ item.text }}
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}