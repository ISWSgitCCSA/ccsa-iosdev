<?php

/**
 * @file
 * Provides wait list functionality for the Entity Registration module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\registration_waitlist\Hook\RegistrationWaitlistHooks;

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function registration_waitlist_entity_type_alter(array &$entity_types): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_entity_type_build().
 */
#[LegacyHook]
function registration_waitlist_entity_type_build(array &$entity_types): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->entityTypeBuild($entity_types);
}

/**
 * Implements hook_field_info_alter().
 */
#[LegacyHook]
function registration_waitlist_field_info_alter(array &$info): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->fieldInfoAlter($info);
}

/**
 * Implements hook_field_widget_info_alter().
 */
#[LegacyHook]
function registration_waitlist_field_widget_info_alter(array &$info): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->fieldWidgetInfoAlter($info);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function registration_waitlist_registration_presave(EntityInterface $entity): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->registrationPresave($entity);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
#[LegacyHook]
function registration_waitlist_form_registration_type_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->formRegistrationTypeFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function registration_waitlist_form_registration_settings_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->formRegistrationSettingsFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_entity_base_field_info().
 */
#[LegacyHook]
function registration_waitlist_entity_base_field_info(EntityTypeInterface $entity_type): array {
  return \Drupal::service(RegistrationWaitlistHooks::class)->entityBaseFieldInfo($entity_type);
}

/**
 * Implements hook_migration_plugins_alter().
 */
#[LegacyHook]
function registration_waitlist_migration_plugins_alter(array &$migrations): void {
  \Drupal::service(RegistrationWaitlistHooks::class)->migrationPluginsAlter($migrations);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function registration_waitlist_theme(): array {
  return \Drupal::service(RegistrationWaitlistHooks::class)->theme();
}

/**
 * Implements submit handler for hook_form_BASE_FORM_ID_alter().
 */
function registration_waitlist_form_registration_type_submit(array &$form, FormStateInterface $form_state): void {
  $registration_type = $form_state->getFormObject()->getEntity();
  $registration_type->setThirdPartySetting('registration_waitlist', 'confirmation_email', $form_state->getValue([
    'registration_waitlist',
    'confirmation_email',
  ]));
  $registration_type->setThirdPartySetting('registration_waitlist', 'confirmation_email_subject', $form_state->getValue([
    'registration_waitlist',
    'confirmation_email_subject',
  ]));
  $registration_type->setThirdPartySetting('registration_waitlist', 'confirmation_email_message', $form_state->getValue([
    'registration_waitlist',
    'confirmation_email_message',
  ]));
  $registration_type->setThirdPartySetting('registration_waitlist', 'autofill_sort_field', $form_state->getValue([
    'registration_waitlist',
    'registration_waitlist_autofill',
    'autofill_sort_field',
  ]));
  $registration_type->setThirdPartySetting('registration_waitlist', 'autofill_sort_order', $form_state->getValue([
    'registration_waitlist',
    'registration_waitlist_autofill',
    'autofill_sort_order',
  ]));
  $registration_type->save();
}
