<?php

/**
 * @file
 * Provides purging of registration data for registrations.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\registration_purger\Hook\RegistrationPurgerHooks;

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function registration_purger_entity_delete(EntityInterface $entity) {
  \Drupal::service(RegistrationPurgerHooks::class)->entityDelete($entity);
}

/**
 * Implements hook_entity_update().
 */
#[LegacyHook]
function registration_purger_entity_update(EntityInterface $entity) {
  \Drupal::service(RegistrationPurgerHooks::class)->entityUpdate($entity);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function registration_purger_form_registration_admin_settings_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(RegistrationPurgerHooks::class)->formRegistrationAdminSettingsAlter($form, $form_state, $form_id);
}

/**
 * Implements submit handler for hook_form_FORM_ID_alter().
 */
function registration_purger_form_registration_admin_settings_submit(&$form, FormStateInterface $form_state) {
  $config = \Drupal::service('config.factory')->getEditable('registration_purger.settings');
  $config
    ->set('purge_registration_settings_on_delete', $form_state->getValue('purge_registration_settings_on_delete'))
    ->set('purge_registration_on_delete', $form_state->getValue('purge_registration_on_delete'))
    ->set('purge_registration_settings_on_update', $form_state->getValue('purge_registration_settings_on_update'))
    ->set('purge_registration_on_update', $form_state->getValue('purge_registration_on_update'))
    ->save();
}
