<?php

/**
 * @file
 * Provides inline entity form support for the Entity Registration module.
 */

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Session\AccountInterface;
use Drupal\registration_inline_entity_form\Hook\RegistrationInlineEntityFormHooks;

/**
 * Implements hook_entity_access().
 */
#[LegacyHook]
function registration_inline_entity_form_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  return \Drupal::service(RegistrationInlineEntityFormHooks::class)->entityAccess($entity, $operation, $account);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function registration_inline_entity_form_entity_type_alter(array &$entity_types): void {
  \Drupal::service(RegistrationInlineEntityFormHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function registration_inline_entity_form_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(RegistrationInlineEntityFormHooks::class)->formAlter($form, $form_state, $form_id);
}
