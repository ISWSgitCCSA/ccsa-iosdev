<?php

/**
 * @file
 * Provides cancel by functionality for the Entity Registration module.
 */

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\registration_cancel_by\Hook\RegistrationCancelByHooks;

/**
 * Implements hook_entity_base_field_info().
 */
#[LegacyHook]
function registration_cancel_by_entity_base_field_info(EntityTypeInterface $entity_type): array {
  return \Drupal::service(RegistrationCancelByHooks::class)->entityBaseFieldInfo($entity_type);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function registration_cancel_by_entity_type_alter(array &$entity_types): void {
  \Drupal::service(RegistrationCancelByHooks::class)->entityTypeAlter($entity_types);
}
